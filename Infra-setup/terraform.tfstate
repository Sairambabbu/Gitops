            "id": "1068665009",
            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": \"sts:AssumeRoleWithWebIdentity\",\n      \"Principal\": {\n        \"Federated\": \"arn:aws:iam::375609200788:oidc-provider/oidc.eks.us-east-1.amazonaws.com/id/51DDDB144657F4D2EF3F349E465D4C17\"\n      },\n      \"Condition\": {\n        \"StringEquals\": {\n          \"oidc.eks.us-east-1.amazonaws.com/id/51DDDB144657F4D2EF3F349E465D4C17:sub\": \"system:serviceaccount:kube-system:cluster-autoscaler\"\n        }\n      }\n    }\n  ]\n}",
